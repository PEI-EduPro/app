#PosteGres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase

# Keycloak DB
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak

#Keycloak Server
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080

KEYCLOAK_REALM=edupro
KEYCLOAK_CLIENT_ID=api-backend
KEYCLOAK_CLIENT_SECRET=**********

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_USERNAME=admin

KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080  # Commented out for prod - nginx proxies on port 80. Uncomment for access to keycloak

#Exposed Ports
API_PORT=8000
KEYCLOAK_PORT=8080
WEB_PORT=5173 # 80 for prod and 5173 or whatever u want for dev

#Logging
LOG_LEVEL=DEBUG
SQLALCHEMY_LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=DEBUG
DB_ECHO=true