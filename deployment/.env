# POSTGRES (App Database)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase

# Keycloak (for API to connect)
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080
KEYCLOAK_REALM=edupro
KEYCLOAK_CLIENT_ID=api-backend
KEYCLOAK_CLIENT_SECRET=**********
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Services (for docker-compose substitution)
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KEYCLOAK_ADMIN=admin

#Logging
DB_ECHO=true
LOG_LEVEL=DEBUG
SQLALCHEMY_LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=DEBUG
